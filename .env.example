# ── Bot credentials (from Discord Developer Portal → your app → Bot tab) ──────
BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here

# ── Guild (server) ID ─────────────────────────────────────────────────────────
# Right-click your server icon → Copy Server ID (requires Developer Mode)
# Used for instant slash command registration during development.
# Remove or leave blank to register commands globally (takes ~1 hour).
GUILD_ID=your_guild_id_here

# ── Channel IDs ───────────────────────────────────────────────────────────────
# Right-click a channel → Copy Channel ID
WELCOME_CHANNEL_ID=your_welcome_channel_id_here
ANNOUNCEMENT_CHANNEL_ID=your_announcement_channel_id_here

# ── Reaction role IDs ─────────────────────────────────────────────────────────
# Right-click a role in Server Settings → Roles → Copy Role ID
ROLE_GAMER_ID=your_gamer_role_id_here
ROLE_DEVELOPER_ID=your_developer_role_id_here
ROLE_ANNOUNCEMENTS_ID=your_announcements_role_id_here

# ── Web Dashboard ──────────────────────────────────────────────────────────────
# Discord app's OAuth2 client secret (OAuth2 tab in Dev Portal → Client Secret)
CLIENT_SECRET=your_client_secret_here

# Random secret string used to sign session cookies — change this to anything long and random
DASHBOARD_SECRET=replace_with_a_long_random_string

# Port the dashboard web server listens on (default: 3000)
DASHBOARD_PORT=3000

# The OAuth2 redirect URI — must be added EXACTLY in Dev Portal → OAuth2 → Redirects
DASHBOARD_CALLBACK_URL=http://localhost:3000/auth/callback

# Comma-separated Discord user IDs of people allowed to log into the dashboard
# How to get your ID: Discord → Settings → Advanced → Developer Mode, then right-click your name
ADMIN_IDS=your_discord_user_id_here
